# Build context for deploy/docker multi-stage images.
# Do not send secrets, local Compose state, tests, or generated caches.
.git
.github
.compose-data
secrets
*.secret
.env
.env.*
!.env.example
*.log
coverage.out
coverage.html
frontend/node_modules
frontend/dist
frontend/.vite
**/*.test
**/*.test.ts
**/*_test.go
**/*.out
test
docs
*.md
!go.mod
config/examples/secrets
deploy/compose
deploy/examples
test/e2e
test/fixtures
