# labldap-bootstrap:dev (OD-004). Do not push.
# Static bootstrap binary on the pinned 389 DS image so dsconf/dsctl remain
# available. Secrets are never baked; pass them as mounts only.

# FROM-time ARGs must be declared before the first FROM (legacy builder).
ARG GO_IMAGE=golang:1.26.5
ARG DIRSRV_IMAGE=quay.io/389ds/dirsrv@sha256:f2851654c5df545cd893d84bea8d08c28dc25f0930493fbfed1d8a6eacf657f7
FROM ${GO_IMAGE} AS build
WORKDIR /src
ENV CGO_ENABLED=0
ENV GOTOOLCHAIN=go1.26.5
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN go build -trimpath -ldflags="-s -w" -o /out/labldap-bootstrap ./cmd/labldap-bootstrap

# Default matches deploy/docker/dirsrv.digest. Release files must stay digest-pinned.
FROM ${DIRSRV_IMAGE}
COPY --from=build /out/labldap-bootstrap /usr/local/bin/labldap-bootstrap
# Override the dirsrv first-boot command so a bare run cannot start a second instance.
ENTRYPOINT ["/usr/local/bin/labldap-bootstrap"]
CMD ["--help"]
