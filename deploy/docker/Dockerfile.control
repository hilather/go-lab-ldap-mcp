# labldap-control:dev (OD-004). Do not push.
# Multi-stage frontend (pnpm) + static Go binary with embedded UI.
# Runtime is non-root, has CA certificates, and contains no source, package
# manager cache, test secrets, or Directory Manager credentials.

# FROM-time ARGs must be declared before the first FROM (legacy builder).
ARG GO_IMAGE=docker.io/library/golang:1.26.5@sha256:705e964a93a2fd2e75c7d59bb7d781b57e30f12293ffde5175c69229e18fb678
ARG NODE_IMAGE=docker.io/library/node:22.14.0-bookworm@sha256:e5ddf893cc6aeab0e5126e4edae35aa43893e2836d1d246140167ccc2616f5d7
ARG ALPINE_IMAGE=docker.io/library/alpine:3.21@sha256:48b0309ca019d89d40f670aa1bc06e426dc0931948452e8491e3d65087abc07d

FROM ${NODE_IMAGE} AS frontend
WORKDIR /src
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@10.14.0 --activate
COPY frontend/package.json frontend/pnpm-lock.yaml /src/frontend/
COPY api/generated/typescript /src/api/generated/typescript
WORKDIR /src/frontend
RUN pnpm install --frozen-lockfile
COPY frontend /src/frontend
RUN pnpm build

FROM ${GO_IMAGE} AS build
WORKDIR /src
ENV CGO_ENABLED=0
ENV GOTOOLCHAIN=go1.26.5
ARG VERSION=dev
ARG REVISION=unknown
ARG BUILT_AT=unknown
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY --from=frontend /src/frontend/dist/ /src/internal/web/dist/
RUN go build -trimpath \
	-ldflags="-s -w -X github.com/hilather/go-lab-ldap-mcp/internal/observability.version=${VERSION} -X github.com/hilather/go-lab-ldap-mcp/internal/observability.revision=${REVISION} -X github.com/hilather/go-lab-ldap-mcp/internal/observability.builtAt=${BUILT_AT}" \
	-o /out/labldap ./cmd/labldap

FROM ${ALPINE_IMAGE}
ARG VERSION=dev
ARG REVISION=unknown
ARG BUILT_AT=unknown
RUN apk add --no-cache ca-certificates wget \
	&& adduser -D -H -u 65532 -g labldap labldap \
	&& rm -rf /var/cache/apk /root/.cache
COPY --from=build /out/labldap /usr/local/bin/labldap
USER 65532:65532
EXPOSE 8443
# Documented writable tmpfs at runtime: /tmp only (Compose read-only root).
LABEL org.opencontainers.image.title="labldap-control" \
	org.opencontainers.image.description="LabLDAP control plane. No Directory Manager credentials. Do not push (OD-004)." \
	org.opencontainers.image.version="${VERSION}" \
	org.opencontainers.image.revision="${REVISION}" \
	org.opencontainers.image.created="${BUILT_AT}" \
	org.opencontainers.image.source="https://github.com/hilather/go-lab-ldap-mcp"
HEALTHCHECK --interval=5s --timeout=3s --start-period=3s --retries=10 \
	CMD wget -q -O - http://127.0.0.1:8443/health || exit 1
ENTRYPOINT ["/usr/local/bin/labldap"]
CMD ["serve", "--placeholder"]
