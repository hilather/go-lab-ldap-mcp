# labldap-control:placeholder is a thin T-042 image, not T-108.
# Do not tag this labldap-control:dev. Do not push (OD-004).

ARG GO_IMAGE=docker.io/library/golang:1.26.10@sha256:672c944cfd07599b5f1bb179869270cdc94c6254e41db4d431259693cb286b82
ARG ALPINE_IMAGE=alpine:3.21
FROM ${GO_IMAGE} AS build
WORKDIR /src
ENV CGO_ENABLED=0
ENV GOTOOLCHAIN=go1.26.10
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN go build -trimpath -ldflags="-s -w" -o /out/labldap ./cmd/labldap

FROM ${ALPINE_IMAGE}
COPY --from=build /out/labldap /usr/local/bin/labldap
USER nobody
ENTRYPOINT ["/usr/local/bin/labldap"]
CMD ["serve", "--placeholder"]
